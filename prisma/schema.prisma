generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String?      @unique
  emailVerified  DateTime?
  image          String?
  role           String       @default("viewer") // admin, analyst, viewer
  organizationId String?
  accounts       Account[]
  sessions       Session[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Application models
model Organization {
  id            String        @id @default(cuid())
  name          String
  industry      String
  employeeCount String?
  annualBudget  Float?
  logoUrl       String?
  users         User[]
  departments   Department[]
  vendors       Vendor[]
  transactions  Transaction[]
  contracts     Contract[]
  flags         Flag[]
  auditLogs     AuditLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Department {
  id              String        @id @default(cuid())
  name            String
  organizationId  String
  allocatedBudget Float         @default(0)
  headcount       Int?
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Vendor {
  id               String        @id @default(cuid())
  name             String
  organizationId   String
  address          String?
  contactEmail     String?
  website          String?
  riskScore        Int           @default(0)
  totalPaid        Float         @default(0)
  transactionCount Int           @default(0)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  contracts        Contract[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Transaction {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime
  vendorId       String?
  vendorName     String
  amount         Float
  departmentId   String?
  departmentName String
  category       String
  description    String
  approvalStatus String       @default("pending")
  fiscalYear     String
  fiscalQuarter  Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor?      @relation(fields: [vendorId], references: [id])
  department     Department?  @relation(fields: [departmentId], references: [id])
  createdAt      DateTime     @default(now())
}

model Contract {
  id             String       @id @default(cuid())
  organizationId String
  vendorId       String
  title          String
  value          Float
  currentValue   Float
  startDate      DateTime
  endDate        DateTime
  renewalStatus  String       @default("active")
  competitiveBid Boolean      @default(true)
  deliverables   String       @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor       @relation(fields: [vendorId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Flag {
  id                     String       @id @default(cuid())
  organizationId         String
  type                   String
  severity               String       // critical, warning, info
  title                  String
  description            String       @db.Text
  estimatedWaste         Float
  status                 String       @default("new") // new, under_review, resolved, dismissed
  assignee               String?
  affectedTransactionIds String[]
  affectedDepartment     String?
  affectedVendor         String?
  recommendation         String       @db.Text
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model AuditLog {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  action         String
  resource       String
  resourceId     String?
  details        String       @db.Text
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}
